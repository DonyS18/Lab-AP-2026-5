def deteksi_anomali_email(email):
    error = []

    # 1. Harus memiliki tepat satu @
    if email.count("@") != 1:
        error.append("Email harus memiliki tepat satu karakter @.")
        return error

    local, domain = email.split("@")

    # 2. Local dan domain tidak boleh kosong
    if local == "":
        error.append("Bagian local tidak boleh kosong.")

    if domain == "":
        error.append("Bagian domain tidak boleh kosong.")

    # 3. Tidak boleh ada spasi
    if " " in email:
        error.append("Email tidak boleh mengandung spasi.")

    # 4. Aturan bagian local
    if local != "":
        if local[0] == ".":
            error.append("Local tidak boleh diawali titik.")

        if local[-1] == ".":
            error.append("Local tidak boleh diakhiri titik.")

        if ".." in local:
            error.append("Local tidak boleh memiliki titik berurutan.")

    # 5. Aturan bagian domain
    if domain != "":
        if "." not in domain:
            error.append("Domain harus memiliki minimal satu titik.")

        if ".." in domain:
            error.append("Domain tidak boleh memiliki titik berurutan.")

        if domain[-1] == ".":
            error.append("Domain tidak boleh diakhiri titik.")

    # 7. Domain resmi
    if not (
        domain.endswith(".com")
        or domain.endswith(".id")
        or domain.endswith(".ac.id")
    ):
        error.append("Email harus berakhiran .com, .id, atau .ac.id.")

    return error


def cetak_daftar(daftar_email_valid, karakter_border):
    if len(daftar_email_valid) == 0:
        return "Tidak ada email valid."

    panjang_maksimal = max(len(email) for email in daftar_email_valid)

    border = karakter_border * (panjang_maksimal + 4)

    hasil = border + "\n"

    for email in daftar_email_valid:
        hasil += "| " + email

        spasi = panjang_maksimal - len(email)
        hasil += " " * spasi

        hasil += " |\n"

    hasil += border

    return hasil


daftar_email_valid = []

while True:
    email = input("\nMasukkan email (ketik 'tutup' untuk selesai): ")

    if email.lower() == "tutup":
        break

    error = deteksi_anomali_email(email)

    # 6. Cek duplikat
    if email in daftar_email_valid:
        error.append("Email sudah terdaftar atau duplikat.")

    if len(error) == 0:
        daftar_email_valid.append(email)
        print("Email valid.")
    else:
        print("Email tidak valid.")
        for masalah in error:
            print("-", masalah)


print("\n=== DAFTAR EMAIL VALID ===")
print(cetak_daftar(daftar_email_valid, "="))
