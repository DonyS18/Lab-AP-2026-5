ALFABET = "abcdefghijklmnopqrstuvwxyz"


def bersihkan_teks(teks):
    hasil = ""

    for karakter in teks:
        if karakter.lower() in ALFABET:
            hasil += karakter.lower()

    return hasil


def cek_palinrome(teks):
    teks_balik = "".join(reversed(teks))

    if teks == teks_balik:
        return True, -1

    for i in range(len(teks)):
        if teks[i] != teks_balik[i]:
            return False, i

    return False, -1


def inti_palinrome(teks):
    teks = bersihkan_teks(teks)

    palindrom_terbaik = ""
    indeks_terbaik = 0

    for i in range(len(teks)):
        for j in range(i + 1, len(teks) + 1):
            substring = teks[i:j]

            hasil, indeks = cek_palinrome(substring)

            if hasil and len(substring) > len(palindrom_terbaik):
                palindrom_terbaik = substring
                indeks_terbaik = i

    return {
        "teks": palindrom_terbaik,
        "panjang": len(palindrom_terbaik),
        "indeks_awal": indeks_terbaik
    }


teks = input("Masukkan teks: ")

hasil = inti_palinrome(teks)

print(hasil)